var MES=['ene','feb','mar','abr','may','jun','jul','ago','sep','oct','nov','dic'];
function fmt(d){var p=d.split('-');return (+p[2])+' '+MES[+p[1]-1]+' '+p[0]}
function addDays(d,n){var x=new Date(d+'T12:00:00');x.setDate(x.getDate()+n);return iso(x)}
function iso(x){return x.getFullYear()+'-'+String(x.getMonth()+1).padStart(2,'0')+'-'+String(x.getDate()).padStart(2,'0')}
function today(){return iso(new Date())}
function schedule(){var t=today(),out=[],d=START,i=0;while(d<t&&i<60){d=addDays(d,14);i++}for(var k=0;k<4;k++)out.push(addDays(d,14*k));return out}

/* ---------- Data helpers ---------- */
function hist(pid){return state.pesajes.filter(function(x){return x.p===pid}).sort(function(a,b){return a.f<b.f?-1:a.f>b.f?1:0})}
function r1(n){return Math.round(n*10)/10}
function sgn(n,dec){var v=dec===0?Math.round(n):r1(n);return (v>0?'+':v<0?'−':'±')+Math.abs(v).toFixed(dec===0?0:1)}
function chip(delta,goodWhen,unit,dec,tol){
  if(delta==null)return '';
  var v=dec===0?Math.round(delta):r1(delta),cls='';
  if(v===0)cls='';
  else if(goodWhen==='down')cls=v<0?'good':'bad';
  else cls=v>0?'good':(tol!=null&&v>=-tol?'warn':'bad');
  return '<span class="chip '+cls+'">'+sgn(delta,dec)+(unit||'')+'</span>';
}
function standings(){
  var rows=ORDER.map(function(pid){
    var h=hist(pid),a=h[0],b=h[h.length-1];
    if(!a)return {pid:pid,none:true};
    var has=h.length>1;
    return {pid:pid,a:a,b:b,has:has,n:h.length,
      score:has?r1(a.grasa-b.grasa):null,
      dm:has?r1(b.musculo-a.musculo):null,
      dv:has?(b.visceral-a.visceral):null,
      ok:has?(b.musculo-a.musculo)>=-0.5:true};
  });
  rows.sort(function(x,y){
    if(x.none!==y.none)return x.none?1:-1;
    if(x.has!==y.has)return x.has?-1:1;
    if(!x.has)return ORDER.indexOf(x.pid)-ORDER.indexOf(y.pid);
    if(x.ok!==y.ok)return x.ok?-1:1;
    if(y.score!==x.score)return y.score-x.score;
    return x.dv-y.dv;
  });
  return rows;
}

