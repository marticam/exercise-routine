  if(d!=='walk')s+='<div class="callout"><b>Calentamiento (5 min, siempre):</b> 1 minuto marchando en el sitio, 10 círculos de brazos, 10 sentadillas lentas sin peso, 10 puentes de glúteo y 10 "gato-vaca" en cuatro apoyos.</div>';
  s+='<section class="card"><div class="list-head"><h3>'+D.title+'</h3>'+progressLine(pid,d,D.items.length)+'</div><div class="list">'+
    exRows(pid,d,D.items,function(x){return '<div><div class="nm">'+x[0]+'</div><div class="how">'+x[2]+'</div></div><div class="sr">'+x[1]+'</div>'})+'</div></section>';
  if(d!=='walk'){
    s+=timerBlock();
    s+='<section class="card"><ul class="bullets"><li><b>Descanso:</b> 60–90 s entre series. Al terminar, 5 minutos de estiramiento.</li><li><b>Cómo progresar:</b> la última serie debe sentirse difícil, como si solo quedaran 2 repeticiones más. Cuando todas las series salgan completas, se sube algo cada semana: más peso en la mochila, 2 repeticiones más o una versión más difícil (lagartija de pared → mesa → rodillas → piso). Esto es lo que mantiene el músculo mientras se baja grasa.</li><li><b>Si solo pueden 2 días,</b> hacen el A y el B. <b>Si quieren 4,</b> repiten el A.</li></ul></section>';
  }
  return s;
}
function gymEx(pid){
  var d=days[pid]&&GYM[days[pid]]?days[pid]:'lunes',D=GYM[d];
  var s=dayTabs(GYM_ORDER,GYM,d);
  s+='<section class="card"><div class="list-head"><h3>'+D.title+'</h3>'+progressLine(pid,d,D.items.length)+'</div><div class="list">'+
    exRows(pid,d,D.items,function(x){return '<div><div class="nm">'+x[0]+'</div></div><div class="sr">'+x[1]+' × '+x[2]+'<small>Desc. '+x[3]+'</small></div>'})+'</div></section>';
  if(D.core){
    s+='<section class="card"><div class="list-head"><h3>'+D.core[0]+'</h3></div><div class="list">'+D.core[1].map(function(x){return '<div class="row ex"><span></span><div class="nm">'+x[0]+'</div><div class="sr">'+x[1]+' × '+x[2]+'<small>Desc. '+x[3]+'</small></div></div>'}).join('')+'</div></section>';
  }
  s+=timerBlock();
  s+='<div class="callout"><b>Progresión:</b> cuando completes el máximo de reps con buena técnica, aumenta ligeramente la carga la próxima sesión. Mantén 1–2 reps en reserva en los ejercicios principales.</div>';
  return s;
}
function seniorEx(pid){
  var s='<p class="lead">Hacer fuerza <b>2–3 veces por semana</b> con la rutina adaptada. Mejor 2 series de 10–12, sin saltos. Con la edad, el músculo se pierde rápido si no se usa.</p>';
  s+='<section class="card"><div class="list-head"><h3>Rutina de fuerza adaptada</h3>'+progressLine(pid,'fuerza',SENIOR_EX.length)+'</div><div class="list">'+
    exRows(pid,'fuerza',SENIOR_EX,function(x){return '<div><div class="nm">'+x[0]+'</div><div class="how">'+x[2]+'</div></div><div class="sr">'+x[1]+'</div>'})+'</div></section>';
  s+=timerBlock();
  s+='<section class="card"><ul class="bullets"><li><b>Caminar 10–15 minutos después del almuerzo y de la cena.</b> Es de lo que más baja el azúcar después de comer.</li><li><b>Pasos:</b> al menos 7,000 al día, como todas.</li><li><b>Cuidar los pies:</b> zapato cerrado y cómodo para caminar, y revisarse los pies si tienen diabetes de hace muchos años.</li></ul></section>';
  return s;
}
function tfmt(){return String(Math.floor(timerSec/60)).padStart(2,'0')+':'+String(timerSec%60).padStart(2,'0')}
function drawTimer(){var el=document.getElementById('timer');if(el)el.textContent=tfmt()}

/* ---------- Ranking ---------- */
function rankingView(){
  var rows=standings(),anyHas=rows.some(function(r){return r.has}),sch=schedule();
  var s='';
  if(!anyHas){
    s+='<div class="callout good">Por ahora solo está la <b>medición inicial del '+fmt(START)+'</b>. El ranking empieza a moverse en el próximo pesaje, el <b>'+fmt(sch[0]===START?sch[1]:sch[0])+'</b>.</div>';
  }
  s+='<section class="card"><div class="list-head"><h3>'+(anyHas?'Posiciones':'Participantes')+'</h3><span class="sec-sub">Puntaje = puntos de % de grasa que bajó</span></div><div class="list">';
  var pos=0;
  rows.forEach(function(r){
    if(r.none){s+='<div class="row rank-row"><span class="pos">–</span>'+av(r.pid)+'<div><button class="linkish who" data-go="'+r.pid+'">'+PEOPLE[r.pid].name+'</button><div class="meta">Sin pesajes</div></div><span></span></div>';return}
    var label,meta;
    if(r.has){
      if(r.ok)pos++;
      label=r.ok?String(pos):'—';
      meta=chip(r.dm,'up',' kg músculo',1,0.5)+chip(r.dv,'down',' visceral',0)+(r.ok?'':'<span class="chip bad">Perdió músculo: no puede ganar</span>');
    }else{
      label='·';
      meta='<span>Inicial: '+r.a.grasa.toFixed(1)+'% grasa · '+r.a.musculo.toFixed(1)+' kg músculo · visceral '+r.a.visceral+'</span>';
    }
    s+='<div class="row rank-row'+(r.has&&r.ok&&pos===1?' first':'')+'"><span class="pos num">'+label+'</span>'+av(r.pid)+'<div style="min-width:0"><button class="linkish who" data-go="'+r.pid+'">'+PEOPLE[r.pid].name+'</button><div class="meta">'+meta+'</div></div>'+
      (r.has?'<div class="score"><b class="num">'+(r.score>0?'−':r.score<0?'+':'')+Math.abs(r.score).toFixed(1)+'</b><span>pts grasa</span></div>':'<div class="score"><b class="num">'+r.a.grasa.toFixed(1)+'%</b><span>grasa inicial</span></div>')+'</div>';
  });
  s+='</div></section>';

  s+='<section class="card"><div class="list-head"><h3>Últimas mediciones</h3><span class="sec-sub">Cambio contra la medición inicial</span></div><div class="tbl-wrap"><table><thead><tr><th>Nombre</th><th>Fecha</th><th>Peso</th><th>% grasa</th><th>Grasa kg</th><th>Músculo</th><th>Visceral</th></tr></thead><tbody>'+
    ORDER.map(function(pid){var h=hist(pid);if(!h.length)return '<tr><td>'+PEOPLE[pid].name+'</td><td colspan="6" style="text-align:left;color:var(--muted)">Sin pesajes</td></tr>';var a=h[0],b=h[h.length-1],has=h.length>1;
      return '<tr><td><b>'+PEOPLE[pid].name+'</b></td><td>'+fmt(b.f)+'</td><td>'+b.peso.toFixed(1)+(has?' '+chip(b.peso-a.peso,'down',''):'')+'</td><td>'+b.grasa.toFixed(1)+'%'+(has?' '+chip(b.grasa-a.grasa,'down',''):'')+'</td><td>'+(b.grasaKg!=null?b.grasaKg.toFixed(1):'—')+'</td><td>'+b.musculo.toFixed(1)+(has?' '+chip(b.musculo-a.musculo,'up','',1,0.5):'')+'</td><td>'+b.visceral+(has?' '+chip(b.visceral-a.visceral,'down','',0):'')+'</td></tr>'}).join('')+
    '</tbody></table></div></section>';

  s+='<section class="card pad stack"><div><h3 class="sec-h">Próximos pesajes</h3><p class="sec-sub">Cada 2 semanas, en ayunas, después de ir al baño y antes de entrenar.</p></div><div class="dates">'+sch.map(function(d,i){return '<span class="'+(i===0?'next':'')+'">'+fmt(d)+'</span>'}).join('')+'</div></section>';

  if(canEdit){
    if(showForm)s+=formBlock();
    else s+='<button class="btn primary" data-act="openform">Registrar pesaje</button>';
  }
  return s;
}
function formBlock(){
  var p=formPerson||ORDER[0],sch=schedule(),def=sch[0]<=today()?sch[0]:today();
  return '<form class="card pad stack" id="f-pesaje" novalidate><div><h3 class="sec-h">Registrar pesaje</h3><p class="sec-sub">Mismos datos de la báscula. Si ya hay un pesaje de esa persona en esa fecha, se reemplaza.</p></div>'+
    '<div class="form">'+
    '<label>Persona<select id="fp-p">'+ORDER.map(function(x){return '<option value="'+x+'"'+(x===p?' selected':'')+'>'+PEOPLE[x].name+'</option>'}).join('')+'</select></label>'+
    '<label>Fecha<input type="date" id="fp-f" value="'+def+'"></label>'+
    '<label>Peso (kg)<input id="fp-peso" inputmode="decimal" placeholder="78.4"></label>'+
    '<label>% grasa<input id="fp-grasa" inputmode="decimal" placeholder="31.1"></label>'+
    '<label>Grasa (kg)<input id="fp-grasaKg" inputmode="decimal" placeholder="Opcional"></label>'+
    '<label>Músculo (kg)<input id="fp-musculo" inputmode="decimal" placeholder="51.3"></label>'+
    '<label>Grasa visceral<input id="fp-visceral" inputmode="numeric" placeholder="15"></label>'+
    '</div><div class="form-actions"><button type="submit" class="btn primary"'+(saving?' disabled':'')+'>'+(saving?'Guardando…':'Guardar pesaje')+'</button><button type="button" class="btn" data-act="closeform">Cancelar</button></div>'+
    '<p class="form-msg'+(formErr?' err':'')+'" id="fp-msg" role="status">'+esc(formMsg)+'</p></form>';
}

/* ---------- Rules & recommendations ---------- */
function rulesView(){
  return '<p class="lead">Gana quien más baje su <b>porcentaje de grasa corporal</b> entre la medición inicial y la final, siempre que mantenga o suba su masa muscular. Así no gana quien baje más kilos a costa de perder músculo.</p>'+
  '<section class="card"><ol class="rules">'+
  '<li><div><b>Puntaje.</b> Se resta el % de grasa final al inicial. Ejemplo: si empieza en 38.9% y termina en 35.4%, bajó <b>3.5 puntos</b>.</div></li>'+
  '<li><div><b>Condición del músculo.</b> La masa muscular final tiene que ser igual o mayor que la inicial. Se acepta hasta <b>0.5 kg menos</b>, por el margen de error de la báscula. Quien pierda más que eso no puede ganar.</div></li>'+
  '<li><div><b>Desempate.</b> Si dos quedan iguales, gana quien más baje su grasa visceral.</div></li>'+
  '<li><div><b>Mediciones válidas.</b> La inicial y la final se hacen en la misma báscula y con el mismo perfil (sexo, edad y estatura correctos). Ambas en ayunas, a la misma hora, después de ir al baño y antes de entrenar.</div></li>'+
  '</ol></section>'+
  '<div class="callout">En el ranking, el músculo se marca en <span class="chip good">verde</span> si subió, en <span class="chip warn">amarillo</span> si bajó hasta 0.5 kg (todavía vale) y en <span class="chip bad">rojo</span> si bajó más.</div>';
}
function recView(){
  var rules=[['Agua','2–2.5 litros al día.'],['Pasos','al menos 7,000 al día.'],['Sueño','7 horas o más.'],['Alcohol','máximo 1 trago por semana.'],['Comida libre','1 por semana, sin que se convierta en un día entero.'],['Pesaje','una vez cada 2 semanas, el mismo día, en la misma báscula, en ayunas, después de ir al baño y antes de entrenar. No pesarse a diario.']];
  return '<section class="card"><div class="list-head"><h3>Reglas para todas</h3></div><ul class="bullets">'+rules.map(function(r){return '<li><b>'+r[0]+':</b> '+r[1]+'</li>'}).join('')+'</ul></section>'+
  '<div class="callout good">Para bajar porciones sin pesar: en almuerzo y cena, <b>la mitad del plato vegetales, un cuarto proteína y un cuarto carbo.</b></div>'+
  '<section class="card"><div class="list-head"><h3>Tabla de porciones</h3><span class="sec-sub">Cada porción equivale a cualquiera de sus opciones. Cantidades aproximadas.</span></div><div class="list">'+
  PORTIONS.map(function(p){return '<div class="row portion"><span class="pn">'+p[0]+'</span><span class="pa">'+p[1]+'</span><span class="po">'+p[2]+'</span></div>'}).join('')+'</div></section>';
}

/* ---------- Render & events ---------- */
function render(){document.getElementById('app').innerHTML=shell();drawTimer()}
function go(r){if(!VIEWS[r])return;route=r;menuOpen=false;confirmDel=null;try{if(location.hash.slice(1)!==r)location.hash=r}catch(e){}render();window.scrollTo(0,0)}
function setMenu(open){menuOpen=open;var d=document.querySelector('.drawer'),sc=document.querySelector('.scrim');if(d){d.classList.toggle('open',open);d.setAttribute('aria-hidden',String(!open))}if(sc)sc.classList.toggle('open',open)}

document.addEventListener('click',function(e){
  var t=e.target.closest('[data-go],[data-act],[data-tab],[data-day],[data-chk],[data-tset],[data-del]');
  if(!t)return;
  if(t.dataset.go){go(t.dataset.go);return}
  if(t.dataset.tab){tabs[route]=t.dataset.tab;lsSet('reto_tabs',tabs);render();return}
  if(t.dataset.day){days[route]=t.dataset.day;lsSet('reto_days',days);render();return}
  if(t.dataset.chk!=null){
    var P=PEOPLE[route],d=P.plan==='senior'?'fuerza':(days[route]||(P.plan==='gym'?'lunes':'a'));
    var k=chkKey(route,d),a=lsGet(k,[]);a[+t.dataset.chk]=!a[+t.dataset.chk];lsSet(k,a);render();return}
  if(t.dataset.tset){clearInterval(timerId);timerId=null;timerSet=timerSec=+t.dataset.tset;render();return}
  if(t.dataset.del){
    if(saving)return;
    if(confirmDel!==t.dataset.del){confirmDel=t.dataset.del;render();return}
    var parts=t.dataset.del.split('|');var backup=JSON.parse(JSON.stringify(state));
    state.pesajes=state.pesajes.filter(function(x){return !(x.p===parts[0]&&x.f===parts[1])});
    confirmDel=null;persist(backup);return}
  var act=t.dataset.act;
  if(act==='menu'){setMenu(!menuOpen);return}
  if(act==='openform'){showForm=true;formMsg='';formErr=false;render();var f=document.getElementById('fp-peso');if(f)f.focus();return}
  if(act==='closeform'){showForm=false;render();return}
  if(act==='tstart'){
    if(timerId){clearInterval(timerId);timerId=null;t.textContent='Iniciar';return}
    if(timerSec<=0)timerSec=timerSet;
    timerId=setInterval(function(){if(timerSec>0){timerSec--;drawTimer()}if(timerSec<=0){clearInterval(timerId);timerId=null;try{navigator.vibrate&&navigator.vibrate([200,100,200])}catch(e){}timerSec=timerSet;render()}},1000);
    t.textContent='Pausar';return}
});
document.addEventListener('keydown',function(e){if(e.key==='Escape'&&menuOpen)setMenu(false)});
document.addEventListener('change',function(e){if(e.target.id==='fp-p')formPerson=e.target.value});
document.addEventListener('submit',function(e){
  if(e.target.id!=='f-pesaje')return;
  e.preventDefault();if(saving)return;
  function num(id){var v=(document.getElementById(id).value||'').trim().replace(',','.');return v===''?null:Number(v)}
  var p=document.getElementById('fp-p').value,f=document.getElementById('fp-f').value;
  var rec={p:p,f:f,peso:num('fp-peso'),grasa:num('fp-grasa'),grasaKg:num('fp-grasaKg'),musculo:num('fp-musculo'),visceral:num('fp-visceral')};
  var missing=[];if(!/^\d{4}-\d{2}-\d{2}$/.test(f))missing.push('fecha');
  [['peso','peso'],['grasa','% grasa'],['musculo','músculo'],['visceral','visceral']].forEach(function(x){if(rec[x[0]]==null||!isFinite(rec[x[0]])||rec[x[0]]<=0)missing.push(x[1])});
  if(rec.grasaKg!=null&&!isFinite(rec.grasaKg))missing.push('grasa kg');
  var msg=document.getElementById('fp-msg');
  if(missing.length){msg.textContent='Falta o no es un número: '+missing.join(', ')+'.';msg.className='form-msg err';return}
  if(rec.grasaKg==null)delete rec.grasaKg;
  formPerson=p;
  var backup=JSON.parse(JSON.stringify(state));
  state.pesajes=state.pesajes.filter(function(x){return !(x.p===p&&x.f===f)});
  state.pesajes.push(rec);
  persist(backup);
});
window.addEventListener('hashchange',function(){var h=location.hash.slice(1);if(VIEWS[h]&&h!==route){route=h;menuOpen=false;render()}});

function buildDoc(){
  var css=document.getElementById('css').textContent;
  var js=document.getElementById('main').textContent;
  var json=JSON.stringify(state).replace(/</g,'\\u003c');
  return '<!doctype html><html><head><meta charset=utf8><meta name=viewport content="width=device-width,initial-scale=1,viewport-fit=cover"><style>'+RESET+'</style></head><body>'+HEAD+
    '<style id="css">'+css+'</style><div id="app"></div><'+S+' type="application/json" id="pesajes">'+json+'</'+S+'><'+S+' id="main">'+js+'</'+S+'></body></html>';
}
function persist(backup){
  function done(text,err){formMsg=text;formErr=!!err;saving=false;render()}
  if(!art){state=backup;done('No se puede guardar desde esta vista.',true);return}
  saving=true;formMsg='Guardando…';formErr=false;render();
  try{sessionStorage.setItem('reto_route',route)}catch(e){}
  art.publish(buildDoc()).then(function(){formMsg='Guardado. Actualizando la página…';render()},function(err){
    state=backup;var c=err&&err.code;
    if(c==='conflict')done('Alguien guardó primero. La página se está actualizando; vuelve a registrarlo si no aparece.',true);
    else if(['not_writer','not_granted','not_declared','capability_disabled','capability_removed','consent_required'].indexOf(c)>=0){canEdit=false;showForm=false;done('Esta vista es solo de lectura.',true)}
    else if(c==='rate_limited')done('Demasiados guardados seguidos. Espera un minuto e intenta de nuevo.',true);
    else done('No se pudo guardar. Intenta de nuevo.',true);
  });
}

/* ---------- Boot ---------- */
(function(){
  var h='';try{h=location.hash.slice(1)}catch(e){}
  var saved=null;try{saved=sessionStorage.getItem('reto_route');sessionStorage.removeItem('reto_route')}catch(e){}
  route=VIEWS[h]?h:(saved&&VIEWS[saved]?saved:'ranking');
  render();
})();
(async function(){
  if(!window.claude||typeof window.claude.use!=='function')return;
  try{art=await window.claude.use('artifact')}catch(e){art=null}
  try{var u=await window.claude.use('user');canEdit=!!(art&&u&&await u.canEdit())}catch(e){canEdit=false}
  if(canEdit)render();
})();
})();
</script>

</body>
