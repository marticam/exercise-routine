.chip.good{background:var(--good-bg);color:var(--good)}
.chip.bad{background:var(--bad-bg);color:var(--bad)}
.chip.warn{background:var(--warn-bg);color:var(--warn)}

.seg{display:grid;grid-template-columns:1fr 1fr;background:var(--sunk);padding:4px;border-radius:13px;gap:4px;position:sticky;top:calc(env(safe-area-inset-top,0px) + 63px);z-index:10}
.seg button{border:0;background:none;border-radius:10px;padding:10px;font-weight:600;color:var(--muted)}
.seg button[aria-selected="true"]{background:var(--surface);color:var(--ink);box-shadow:0 1px 2px rgb(0 0 0/.08)}

.days{display:flex;gap:6px;overflow-x:auto;padding-bottom:2px;scrollbar-width:none}
.days button{flex:none;border:1px solid var(--line);background:var(--surface);border-radius:999px;padding:7px 14px;font-size:13px;font-weight:600}
.days button[aria-selected="true"]{background:var(--accent);border-color:var(--accent);color:var(--accent-ink)}

.list > .row{border-top:1px solid var(--line)}
.list > .row:first-child{border-top:0}
.list-head{padding:14px 16px 10px;border-bottom:1px solid var(--line);display:flex;justify-content:space-between;align-items:baseline;gap:10px;flex-wrap:wrap}
.list-head h3{font-family:var(--display);font-size:16px;margin:0}
.meal{display:grid;grid-template-columns:96px minmax(0,1fr);gap:4px 14px;padding:13px 16px}
.meal .mn{font-weight:700;font-size:14px}
