.nav-ic{width:32px;height:32px;border-radius:50%;display:grid;place-items:center;background:var(--sunk);color:var(--accent);flex:none}
.nav-item[aria-current="page"] .nav-ic{background:var(--surface)}
.nav-ic svg{width:17px;height:17px}

.av{width:32px;height:32px;border-radius:50%;display:grid;place-items:center;color:var(--av-ink);background:var(--pc);font-weight:700;font-size:14px;flex:none;font-family:var(--display)}
.av.lg{width:52px;height:52px;font-size:22px}

.card{background:var(--surface);border:1px solid var(--line);border-radius:16px;overflow:hidden}
.pad{padding:16px}
.sec-h{font-family:var(--display);font-size:18px;margin:0;line-height:1.25;text-wrap:balance}
.sec-sub{font-size:13px;color:var(--muted);margin:2px 0 0}
.stack{display:flex;flex-direction:column;gap:12px}
p{margin:0}
.lead{color:var(--muted);font-size:14px;max-width:62ch}

.hero{display:flex;gap:14px;align-items:center}
.hero h2{font-family:var(--display);font-size:26px;margin:0;line-height:1.1}
.hero .tag{font-size:13px;color:var(--muted)}

.stats{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));border-top:1px solid var(--line)}
.stat{padding:12px 14px;display:flex;flex-direction:column;gap:2px;border-left:1px solid var(--line);min-width:0}
.stat:first-child{border-left:0}
