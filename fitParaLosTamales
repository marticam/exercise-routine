.form label{display:flex;flex-direction:column;gap:4px;font-size:12.5px;font-weight:600;color:var(--muted)}
.form input,.form select{border:1px solid var(--line);background:var(--bg);border-radius:10px;padding:10px 11px;font-size:15px;color:var(--ink);width:100%;min-width:0}
.form .full{grid-column:1/-1}
.form-actions{display:flex;gap:8px;flex-wrap:wrap}
.form-msg{font-size:13px;color:var(--muted);min-height:1em}
.form-msg.err{color:var(--bad)}
