.rules li:first-child{border-top:0}
.rules li::before{counter-increment:r;content:counter(r);width:28px;height:28px;border-radius:50%;background:var(--sunk);color:var(--accent);display:grid;place-items:center;font-weight:700;font-family:var(--display)}

.btn{border:1px solid var(--line);background:var(--surface);border-radius:11px;padding:10px 14px;font-weight:600;font-size:14px}
.btn.primary{background:var(--accent);border-color:var(--accent);color:var(--accent-ink)}
.btn.small{padding:6px 10px;font-size:12.5px}
.btn.danger{color:var(--bad)}
.btn:disabled{opacity:.55;cursor:default}
