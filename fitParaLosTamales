.rank-row .who{font-weight:700}
.rank-row .meta{font-size:12.5px;color:var(--muted);display:flex;gap:6px;flex-wrap:wrap;margin-top:2px}
.rank-row .score{text-align:right;font-variant-numeric:tabular-nums}
.rank-row .score b{font-size:20px;font-family:var(--display);display:block;line-height:1.1}
.rank-row .score span{font-size:11px;color:var(--muted)}
.linkish{border:0;background:none;padding:0;text-align:left}

.tbl-wrap{overflow-x:auto}
table{border-collapse:collapse;width:100%;font-size:13.5px;font-variant-numeric:tabular-nums}
