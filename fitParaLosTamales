.dates span{font-size:13px;padding:6px 11px;border-radius:999px;background:var(--sunk);font-weight:600;font-variant-numeric:tabular-nums}
.dates span.next{background:var(--accent);color:var(--accent-ink)}
details summary{cursor:pointer;padding:12px 16px;font-weight:600;font-size:14px;border-top:1px solid var(--line);list-style:none}
details summary::-webkit-details-marker{display:none}
details summary::after{content:" ▾";color:var(--muted)}
details[open] summary::after{content:" ▴"}
