.nav-label{font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:var(--muted);font-weight:600;padding:0 10px 6px}
.nav-item{display:flex;align-items:center;gap:12px;padding:9px 10px;border-radius:11px;border:0;background:none;font-weight:500;text-align:left;width:100%}
